<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cincuentazoproyecto.controller.HelloController">

  <!-- ===================== ENCABEZADO ===================== -->

  <top>

    <VBox alignment="CENTER" spacing="10">

      <padding>
        <Insets top="15" bottom="10"/>
      </padding>

      <Label text="CINCUENTAZO"
             style="-fx-font-size:30; -fx-font-weight:bold;"/>

      <Label fx:id="lblRonda"
             text="Ronda 1"
             style="-fx-font-size:18;"/>

    </VBox>

  </top>

  <!-- ===================== CENTRO ===================== -->

  <center>

    <VBox alignment="CENTER" spacing="30">

      <!-- ================= CPU 1 ================= -->

      <VBox alignment="CENTER" spacing="5">

        <Label text="CPU 1"/>

        <HBox alignment="CENTER" spacing="8">

          <ImageView fx:id="imgCPU11"
                     fitWidth="80"
                     fitHeight="110"
                     preserveRatio="true"/>

          <ImageView fx:id="imgCPU12"
                     fitWidth="80"
                     fitHeight="110"
                     preserveRatio="true"/>

          <ImageView fx:id="imgCPU13"
                     fitWidth="80"
                     fitHeight="110"
                     preserveRatio="true"/>

          <ImageView fx:id="imgCPU14"
                     fitWidth="80"
                     fitHeight="110"
                     preserveRatio="true"/>

        </HBox>

      </VBox>

      <!-- ================= CPU2 - MESA - CPU3 ================= -->

      <HBox alignment="CENTER" spacing="50">

        <!-- CPU2 -->

        <VBox alignment="CENTER" spacing="5">

          <Label text="CPU 2"/>

          <HBox spacing="5">

            <ImageView fx:id="imgCPU21"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU22"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU23"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU24"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

          </HBox>

        </VBox>

        <!-- ===================== MESA ===================== -->

        <VBox alignment="CENTER" spacing="10">

          <Label text="MESA"
                 style="-fx-font-size:18; -fx-font-weight:bold;"/>

          <ImageView fx:id="imgMesa"
                     fitWidth="90"
                     fitHeight="130"
                     preserveRatio="true"/>

          <Label fx:id="lblSumaMesa"
                 text="Suma: 0"
                 style="-fx-font-size:16; -fx-font-weight:bold;"/>

        </VBox>

        <!-- CPU3 -->

        <VBox alignment="CENTER" spacing="5">

          <Label text="CPU 3"/>

          <HBox spacing="5">

            <ImageView fx:id="imgCPU31"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU32"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU33"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

            <ImageView fx:id="imgCPU34"
                       fitWidth="70"
                       fitHeight="100"
                       preserveRatio="true"/>

          </HBox>

        </VBox>

      </HBox>

      <!-- ===================== JUGADOR ===================== -->

      <VBox alignment="CENTER" spacing="10">

        <Label text="TÚ"
               style="-fx-font-size:18; -fx-font-weight:bold;"/>

        <HBox alignment="CENTER" spacing="10">

          <ImageView fx:id="imgJugador1"
                     fitWidth="90"
                     fitHeight="130"
                     preserveRatio="true"
                     onMouseClicked="#jugarCarta1"/>

          <ImageView fx:id="imgJugador2"
                     fitWidth="90"
                     fitHeight="130"
                     preserveRatio="true"
                     onMouseClicked="#jugarCarta2"/>

          <ImageView fx:id="imgJugador3"
                     fitWidth="90"
                     fitHeight="130"
                     preserveRatio="true"
                     onMouseClicked="#jugarCarta3"/>

          <ImageView fx:id="imgJugador4"
                     fitWidth="90"
                     fitHeight="130"
                     preserveRatio="true"
                     onMouseClicked="#jugarCarta4"/>

        </HBox>

      </VBox>

      <!-- ===================== BOTONES ===================== -->

      <HBox alignment="CENTER" spacing="20">

        <Button fx:id="btnJugar"
                text="Jugar Automático"
                onAction="#jugarRonda"/>

        <Button fx:id="btnReiniciar"
                text="Reiniciar"
                onAction="#reiniciarJuego"/>

      </HBox>

    </VBox>

  </center>

  <!-- ===================== HISTORIAL ===================== -->

  <bottom>

    <TextArea fx:id="txtSalida"
              prefHeight="180"
              editable="false"
              wrapText="true"/>

  </bottom>

</BorderPane>